<?xml version="1.0" encoding="UTF-8"?>
<!-- System LaunchDaemon (runs as root at boot): keeps the scoped VM->Vault pf NAT bridge loaded on
     the live VPN interface. Install to /Library/LaunchDaemons (owner root:wheel, 0644).
     This is a DAEMON (not a LaunchAgent) because pfctl needs root and must run at boot without a
     login session — unlike the build/vault agents, which need the GUI session.
     TEMPLATE: install.sh / `make bridge-install` renders __AGENT_DIR__ -> the clone location. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cgholdings.vault-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__AGENT_DIR__/bridge-vault.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/cgh-vault-bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/cgh-vault-bridge.err.log</string>
</dict>
</plist>
